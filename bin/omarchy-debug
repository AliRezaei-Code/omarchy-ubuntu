#!/bin/bash

# omarchy:summary=Print debugging information
# omarchy:args=[--no-sudo] [--print]
# omarchy:examples=omarchy debug --print --no-sudo
# omarchy:requires-sudo=true

# Resolved next to this script rather than off PATH: the shell tests invoke
# commands by absolute path, and a helper that only answered when PATH happened
# to include bin/ would be a trap in exactly the places that reach for it most.
source "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-pkg-backend"

NO_SUDO=false
PRINT_ONLY=false

while (( $# > 0 )); do
  case "$1" in
    --no-sudo)
      NO_SUDO=true
      shift
      ;;
    --print)
      PRINT_ONLY=true
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: omarchy-debug [--no-sudo] [--print]"
      exit 1
      ;;
  esac
done

LOG_FILE="/tmp/omarchy-debug.log"

if [[ $NO_SUDO = "true" ]]; then
  DMESG_OUTPUT="(skipped - --no-sudo flag used)"
else
  DMESG_OUTPUT="$(sudo dmesg)"
fi

backend=$(omarchy_pkg_backend) || exit $?

# A bug report has to say which packages are the user's own picks and which came
# from somewhere else. Arch decorates that with expac and splits the two sets by
# subtracting the repository list from the explicit one, leaving the AUR
# packages behind. Ubuntu has no AUR and no expac: the installed set is the
# whole answer, and the repository list is never subtracted, because with
# nothing but the installed set to subtract from, every package would read as
# having come from outside a repository.
aur_packages=""
if [[ $backend == "arch" ]]; then
  aur_packages=$(
    comm -13 <(omarchy_pkg_remote_list "$backend" | sort) <(omarchy_pkg_explicit_list "$backend" | sort)
  )
fi

packages_section=$(
  {
    if [[ $backend == "arch" ]]; then
      expac -S '%n %v (%r)' $(omarchy_pkg_explicit_list "$backend") 2>/dev/null
    else
      omarchy_pkg_explicit_list "$backend"
    fi
    [[ -z $aur_packages ]] || printf '%s\n' "$aur_packages" | xargs -r expac -Q '%n %v (AUR)' 2>/dev/null
  } | sort
)

# `omarchy_pkg_query` answers a yes/no and throws its output away, but a bug
# report needs the name and the version it found, which is what `pacman -Q`
# used to print here. dev first, then the packaged build, same order as before.
omarchy_package=$(
  for name in omarchy-dev omarchy; do
    if omarchy_pkg_query "$backend" "$name"; then
      printf '%s %s' "$name" "$(omarchy_pkg_version "$backend" "$name")"
      break
    fi
  done
)

cat > "$LOG_FILE" <<EOF
Date: $(date)
Hostname: $(hostname)
Omarchy Package: ${omarchy_package:-unknown}

=========================================
SYSTEM INFORMATION
=========================================
$(inxi -Farz)

=========================================
DMESG
=========================================
$DMESG_OUTPUT

=========================================
JOURNALCTL (CURRENT BOOT, WARNINGS+ERRORS)
=========================================
$(journalctl -b -p 4..1)

=========================================
INSTALLED PACKAGES
=========================================
$packages_section
EOF

if [[ $PRINT_ONLY = "true" ]]; then
  cat "$LOG_FILE"
  exit 0
fi

OPTIONS=("View log" "Save in current directory")
if ping -c 1 8.8.8.8 >/dev/null 2>&1; then
  OPTIONS=("Upload log" "${OPTIONS[@]}")
fi

ACTION=$(gum choose "${OPTIONS[@]}")

case "$ACTION" in
  "Upload log")
    echo "Uploading debug log to logs.omarchy.org..."
    URL=$(curl -sf -F "file=@$LOG_FILE" -Fexpires=24 https://logs.omarchy.org/)
    if (( $? == 0 )) && [[ -n $URL ]]; then
      echo "✓ Log uploaded successfully!"
      echo "Share this URL:"
      echo ""
      echo "  $URL"
    else
      echo "Error: Failed to upload log file"
      exit 1
    fi
    ;;
  "View log")
    less "$LOG_FILE"
    ;;
  "Save in current directory")
    cp "$LOG_FILE" "./omarchy-debug.log"
    echo "✓ Log saved to $(pwd)/omarchy-debug.log"
    ;;
esac
