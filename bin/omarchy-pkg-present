#!/bin/bash

# omarchy:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
# omarchy:args=<packages...>

# Resolved next to this script rather than off PATH: the shell tests and the
# guard batch both invoke commands by absolute path, and a helper that only
# answered when PATH happened to include bin/ would be a trap in exactly the
# places that reach for it most.
source "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-pkg-backend"

backend=$(omarchy_pkg_backend) || exit $?

omarchy_pkg_query "$backend" "$@"
