#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.

set -euo pipefail

source "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-pkg-backend"
backend=$(omarchy_pkg_backend) || exit $?

updates=()

if [[ ${OMARCHY_PATH:-/usr/share/omarchy} != "/usr/share/omarchy" ]]; then
  upstream=$(git -C "${OMARCHY_PATH:-/usr/share/omarchy}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "${OMARCHY_PATH:-/usr/share/omarchy}" fetch --quiet 2>/dev/null || true

    behind=$(git -C "${OMARCHY_PATH:-/usr/share/omarchy}" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("omarchy-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi

package=""
if omarchy_pkg_query "$backend" omarchy-dev; then
  package=omarchy-dev
elif omarchy_pkg_query "$backend" omarchy; then
  package=omarchy
fi

if [[ -n $package ]]; then
  if [[ $backend == "arch" ]]; then
    update=$(checkupdates --nocolor 2>/dev/null | awk -v package="$package" '$1 == package { print; exit }' || true)
  else
    # checkupdates is a pacman-contrib tool with no Debian equivalent, so the
    # deb answer compares the installed version against the candidate one.
    installed=$(omarchy_pkg_version "$backend" "$package" || true)
    candidate=$(omarchy_pkg_candidate "$backend" "$package" || true)
    if [[ -n $installed && -n $candidate && $candidate != "$installed" ]]; then
      update="$package upgradable from $installed to $candidate"
    fi
  fi
fi

if [[ -n ${update:-} ]]; then
  updates+=("$update")
fi

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Omarchy is up to date"
  exit 1
fi
