#!/bin/bash

# omarchy:summary=Pick one option from a menu
# omarchy:group=menu
# omarchy:name=select
# omarchy:args=prompt [option...] [-- menu args...]
# omarchy:examples=omarchy menu select Format jpg png|omarchy-menu-select Resolution 4k 1080p 720p -- --width 400

# An option may lead with an icon, as "<glyph><TAB><label>", and may trail a
# subtext shown under the label, as "<glyph><TAB><label><TAB><subtext>". The
# menu shows the glyph but never returns it. A plain option returns the label
# alone; an option with a subtext returns "<label><TAB><subtext>", so callers
# with same-named rows get the subtext back as the stable key.

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: omarchy-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
menu_width=""
menu_maxheight=""

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    while (( $# > 0 )); do
      case "$1" in
        --width)
          shift
          if (( $# == 0 )); then
            echo "omarchy-menu-select: --width requires a value" >&2
            exit 1
          fi
          menu_width="$1"
          ;;
        --height|--maxheight)
          arg="$1"
          shift
          if (( $# == 0 )); then
            echo "omarchy-menu-select: $arg requires a value" >&2
            exit 1
          fi
          menu_maxheight="$1"
          ;;
      esac
      shift
    done
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: omarchy-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

# The shell draws the menu; when it is not running there is nobody to draw it
# and the handshake below would spin on a done file that never appears. Probe
# the same way bin/omarchy-restart-shell does before committing to that wait,
# and hand the prompt to the terminal picker instead.
if ! omarchy-shell shell ping >/dev/null 2>&1; then
  # The glyph column and the two-line label/subtext layout are Quickshell
  # presentation with no headless equivalent, so the fallback draws one row
  # per line and drops the glyph. The value is untouched: the row handed to
  # the picker is already what a caller gets back, and the picker's stdout
  # carries no header or status, so --width has nothing to apply to here.
  rows=()
  for option in "${options[@]}"; do
    # An option is "label", "glyph<TAB>label" or "glyph<TAB>label<TAB>subtext",
    # and the glyph is never returned. Tab is the only separator, and tab is
    # IFS whitespace, so runs of tabs collapse and a trailing one drops: the
    # three shapes above are the whole contract, and an empty option stays an
    # empty option rather than becoming a read error.
    fields=()
    if [[ -n $option ]]; then
      IFS=$'\t' read -r -a fields <<<"$option" || true
    fi
    case ${#fields[@]} in
    0 | 1) rows+=("$option") ;;
    2) rows+=("${fields[1]}") ;;
    *) rows+=("${fields[1]}"$'\t'"${fields[2]}") ;;
    esac
  done

  args=(--header "$prompt")
  [[ -n $menu_maxheight ]] && args+=(--maxheight "$menu_maxheight")

  status=0
  selection=$(printf '%s\n' "${rows[@]}" | omarchy-tui-choose "${args[@]}") || status=$?
  if (( status != 0 )); then
    exit "$status"
  fi
  printf '%s\n' "$selection"
  exit 0
fi

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

options_json=$(perl -MEncode=decode -MJSON::PP=encode_json -e 'print encode_json([map { decode("UTF-8", $_) } @ARGV])' "${options[@]}")
payload=$(perl -MEncode=decode -MJSON::PP=encode_json,decode_json -e '
  my $payload = {
    mode => "select",
    prompt => decode("UTF-8", $ARGV[0]),
    options => decode_json($ARGV[1]),
    selectionFile => decode("UTF-8", $ARGV[2]),
    doneFile => decode("UTF-8", $ARGV[3])
  };
  $payload->{width} = int($ARGV[4]) if length($ARGV[4] // "");
  $payload->{maxHeight} = int($ARGV[5]) if length($ARGV[5] // "");
  print encode_json($payload)
' "$prompt" "$options_json" "$selection_file" "$done_file" "$menu_width" "$menu_maxheight")

omarchy-shell shell summon omarchy.menu "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
