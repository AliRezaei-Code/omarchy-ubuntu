#!/bin/bash

# omarchy:summary=Run the test suite and fail only on new failures.
# omarchy:hidden=true

# `./test/all` exits non-zero on any failure, and this tree has carried a
# couple of dozen environment-caused ones since before the port started. A CI
# job that runs it directly is therefore permanently red, and a permanently
# red build is indistinguishable from a broken one -- which is worse than no
# build at all, because it trains everyone to ignore it.
#
# So the signal is "did anything that used to pass stop passing", not "is
# everything green". The known failures are listed in
# packaging/ubuntu/ci-known-failures.txt with a reason for each, and this
# compares the run against that list in both directions: a new failure fails
# the build, and a known failure that has been *fixed* also fails it, because
# leaving a name on a list of things that are wrong is how the list stops
# meaning anything.

set -uo pipefail

root="${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
known="$root/packaging/ubuntu/ci-known-failures.txt"
log="${OMARCHY_CI_LOG:-$(mktemp)}"

if [[ ! -r $known ]]; then
  echo "omarchy-ci-suite: $known is missing; a build cannot say what is new" >&2
  exit 2
fi

"$root/test/all" >"$log" 2>&1
suite_status=$?

# Read the runner's own summary rather than re-deriving it. `./test/shell`
# prints "N of M test files failed:" followed by the list, and it knows things
# a `not ok` line does not say -- a file that exits non-zero without printing
# one, or a suite other than the shell one. Parsing the answer rather than
# reimplementing the question is the whole reason to run the suite at all.
mapfile -t failed < <(
  awk '
    /of [0-9]+ test files failed:/ { collecting = 1; suites = 0; next }
    /of [0-9]+ suites failed:/ { collecting = 1; suites = 1; next }
    collecting && /^  / {
      path = $1
      sub(/^test\/shell\.d\//, "", path)
      sub(/-test\.sh$/, "", path)
      sub(/^test\//, "", path)
      # `test/shell` is a suite, never a test file, and its failures are the
      # ones enumerated by file above it. Counting it would mean a permanently
      # red entry that no single file could ever clear.
      if (path == "shell") next
      print path
      next
    }
    collecting { collecting = 0 }
  ' "$log" |
    sort -u
)

# A reason on the same line is a reasonable thing to write, so it is stripped
# rather than being silently read as part of a name -- which would make the
# list look permanently stale.
mapfile -t expected < <(sed 's/[[:space:]]*#.*$//' "$known" | grep -vE '^[[:space:]]*$' | sort -u)

new=$(comm -23 <(printf '%s\n' "${failed[@]:-}") <(printf '%s\n' "${expected[@]:-}") | grep -v '^$')
fixed=$(comm -13 <(printf '%s\n' "${failed[@]:-}") <(printf '%s\n' "${expected[@]:-}") | grep -v '^$')

printf 'suite: %d checks passed, %d files failed\n' \
  "$(grep -c '^ok - ' "$log")" "${#failed[@]}"

if [[ -n $fixed ]]; then
  echo
  echo "These no longer fail and should come off the known-failures list:"
  printf '  %s\n' $fixed
fi

if [[ -n $new ]]; then
  echo
  echo "These are new failures:" >&2
  printf '  %s\n' $new >&2
  echo >&2
  echo "Full output: $log" >&2
  exit 1
fi

# A stale entry is reported loudly but does not fail the build. It used to, on
# the argument that a list of things that are wrong is only evidence while it is
# true -- which is right, and is why the staleness is printed rather than
# buried. It is not right to fail on it, because a single run cannot tell "fixed"
# from "passed by luck", and this tree contains at least one test
# (system-sleep-ownership-migration) whose result depends on the environment
# rather than on the code. Firing a build for it would mean telling a maintainer
# to delete an entry for a test that is still broken, which is worse than a list
# that rots by one line. Take staleness out of the gate and the list is a
# comment again, so it stays here.
if [[ -n $fixed ]]; then
  echo
  echo "The known-failures list is stale; remove the names above when they are really fixed."
fi

echo "no new failures"

# The suite's own exit status is reported but not decisive: a green run that
# left the list stale is still a build to fix, and a red run whose failures are
# all known has already been accounted for above.
exit 0
