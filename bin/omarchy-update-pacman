#!/bin/bash

# omarchy:summary=Run a pacman transaction for the Omarchy update flow, shielded from desktop session teardown.
# omarchy:args=<pacman-args>
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Resolved next to this script rather than off PATH, because the update flow
# and the shell tests both reach this by absolute path.
exec "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-pkg-transaction" --update pacman "$@"
