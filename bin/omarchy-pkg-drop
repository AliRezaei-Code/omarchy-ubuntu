#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

source "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-pkg-backend"
source "$(dirname -- "${BASH_SOURCE[0]}")/omarchy-pkg-map"

backend=$(omarchy_pkg_backend) || exit $?


omarchy_pkg_map_resolve "$backend" "$@" || true
set -- "${OMARCHY_PKG_MAP_RESOLVED[@]}"

# The autoremove decision below counts the packages the caller named, so the
# count has to be of the translated list, not of the original arguments.
installed=()
declare -A installed_exact=()
declare -A selected=()

while IFS= read -r package_name; do
  installed_exact[$package_name]=1
done < <(omarchy_pkg_list "$backend")

for pkg in "$@"; do
  if [[ -n ${installed_exact[$pkg]} && -z ${selected[$pkg]} ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  # pacman's -Rns always prunes what nothing else needs, so a partial drop on
  # Arch takes orphaned dependencies with it. apt's remove prunes nothing, so
  # the same drop has to ask -- but only when every package the caller named
  # was really there, or a partial drop would take dependencies of a package
  # the caller never asked about.
  remove_args=()
  if [[ $backend == "deb" ]] && (( ${#installed[@]} == $# )); then
    remove_args=(--autoremove)
  fi

  omarchy_pkg_remove "$backend" "${remove_args[@]}" "${installed[@]}"
fi
